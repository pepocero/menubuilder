# Archivos estáticos existentes se sirven primero.
# Si falta un asset (hash antiguo tras un deploy), devolver 404 real
# en lugar de index.html (evita MIME text/html en .js/.css → pantalla en blanco).
/assets/*    /404.html   404
/fonts/*     /404.html   404

# SPA: el resto de rutas de la app → index.html
/*    /index.html   200
